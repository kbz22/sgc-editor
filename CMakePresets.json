{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-default",
      "displayName": "Debug (Default)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "release-default",
      "displayName": "Release (Default)",
      "inherits": "debug-default",
      "binaryDir": "${sourceDir}/build/release-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-default-build",
      "displayName": "Build Debug",
      "configurePreset": "debug-default"
    },
    {
      "name": "release-default-build",
      "displayName": "Build Release",
      "configurePreset": "release-default"
    }
  ]
}
