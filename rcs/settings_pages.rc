#include "settings_dialog.h"
#include <windows.h>
#include <commctrl.h>

IDD_SETTINGS_GENERAL DIALOGEX SETTINGS_LIST_WIDTH + 10, 0, PAGE_WIDTH, PAGE_HEIGHT
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"

BEGIN
    GROUPBOX        "Startup", 0,
                    5, 05, PAGE_WIDTH - 10, 40

    AUTOCHECKBOX    "Automatically restore last session's opened files",
                    IDC_SETTINGS_RESTORE_SESSION,
                    12, 20, PAGE_WIDTH - 24, 12

    GROUPBOX        "File", 0,
                    5, 50, PAGE_WIDTH - 10, 40

    LTEXT           "Default Open file type:", 0,
                    12, 65, 75, 12

    COMBOBOX        IDC_SETTINGS_DEFAULT_FILE_TYPE,
                    90, 63, PAGE_WIDTH - 102, 80,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
END

IDD_SETTINGS_SHORTCUTS DIALOGEX SETTINGS_LIST_WIDTH + 10, 0, PAGE_WIDTH, PAGE_HEIGHT + 7
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"

BEGIN
    LTEXT           "Filter:", 0,
                    65, 8, 75, 12
                    
    EDITTEXT        IDC_SHORTCUT_FILTER, 85, 5, PAGE_WIDTH - 90, 14,
                    ES_AUTOHSCROLL

    CONTROL         "", IDC_SHORTCUT_LIST, WC_LISTVIEW,
                    WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL,
                    5, 22, PAGE_WIDTH - 10, PAGE_HEIGHT - 17
END
