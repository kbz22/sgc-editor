#include "settings_dialog.h"
#include <windows.h>

IDD_SETTINGS DIALOGEX 0, 0, 320, 222
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_SETTINGS_LIST, "SysListView32",
                    WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL,
                    5, 5, 80, 195

    DEFPUSHBUTTON   "OK", IDOK, 155, 203, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 210, 203, 50, 14
    PUSHBUTTON      "Apply", IDC_APPLY_BUTTON, 265, 203, 50, 14
END