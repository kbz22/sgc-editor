#include "new_tileset_dialog.h"
#include <windows.h>

IDD_NEWTILESET_DIALOG DIALOGEX 0, 0, 250, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Tileset"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Name:", IDC_LABEL_TILESET_NAME, 10, 12, 40, 10
    EDITTEXT    IDC_TILESET_NAME,
                70, 10, 120, 12,
                ES_AUTOHSCROLL

    LTEXT       "Image:", IDC_LABEL_IMAGE_PATH, 10, 34, 40, 10
    EDITTEXT    IDC_IMAGE_PATH,
                70, 32, 120, 12,
                ES_AUTOHSCROLL | ES_READONLY

    PUSHBUTTON  "...",
                IDC_BROWSE_IMAGE_BUTTON,
                195, 32, 20, 12

    LTEXT       "Tile Width:", IDC_LABEL_TILE_WIDTH, 10, 56, 55, 10
    EDITTEXT    IDC_TILE_WIDTH,
                70, 54, 30, 12,
                ES_AUTOHSCROLL | ES_NUMBER

    LTEXT       "Tile Height:", IDC_LABEL_TILE_HEIGHT, 10, 74, 55, 10
    EDITTEXT    IDC_TILE_HEIGHT,
                70, 72, 30, 12,
                ES_AUTOHSCROLL | ES_NUMBER

    DEFPUSHBUTTON "Create",
                   IDOK,
                   70, 96, 50, 14

    PUSHBUTTON    "Cancel",
                   IDCANCEL,
                   130, 96, 50, 14
END