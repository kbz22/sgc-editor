#include "new_map_dialog.h"
#include <windows.h>

IDD_NEWMAP_DIALOG DIALOGEX 0, 0, 240, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Map"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Name:", -1, 10, 12, 40, 10
    EDITTEXT    IDC_MAP_NAME, 60, 10, 120, 12, ES_AUTOHSCROLL

    LTEXT       "Tileset:", -1, 10, 32, 40, 10
    COMBOBOX    IDC_TILESET_COMBO,
                60, 30, 120, 80,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON  "New...",
                IDC_NEW_TILESET_BUTTON,
                185, 30, 40, 14

    DEFPUSHBUTTON "Create",
                   IDOK,
                   70, 50, 50, 14

    PUSHBUTTON    "Cancel",
                   IDCANCEL,
                   130, 50, 50, 14
END