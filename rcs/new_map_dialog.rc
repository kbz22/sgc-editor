#include "new_map_dialog.h"
#include <windows.h>

IDD_NEWMAP_DIALOG DIALOGEX 0, 0, 240, 106
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Map"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Name:", IDC_MAP_LABEL_MAP_NAME, 10, 12, 40, 10
    EDITTEXT    IDC_MAP_NAME, 60, 10, 120, 12, ES_AUTOHSCROLL

    LTEXT       "Tileset:", IDC_MAP_LABEL_TILESET, 10, 32, 40, 10
    COMBOBOX    IDC_MAP_TILESET_COMBO,
                60, 30, 120, 80,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON  "New...",
                IDC_MAP_NEW_TILESET_BUTTON,
                185, 30, 40, 14

    AUTOCHECKBOX "Make the new map part of a package",
                 IDC_MAP_INCLUDE_PACKAGE_CHECKBOX,
                 10, 50, 150, 12,
                 WS_TABSTOP

    LTEXT       "Package:", IDC_MAP_LABEL_PACKAGE, 10, 68, 40, 10
    COMBOBOX    IDC_MAP_PACKAGE_COMBO,
                60, 66, 120, 80,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON  "New...",
                IDC_MAP_NEW_PACKAGE_BUTTON,
                185, 66, 40, 14

    DEFPUSHBUTTON "Create",
                   IDOK,
                   70, 86, 50, 14

    PUSHBUTTON    "Cancel",
                   IDCANCEL,
                   130, 86, 50, 14
END