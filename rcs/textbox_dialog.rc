#include "textbox_dialog.h"
#include <windows.h>

IDD_TEXTBOX_DIALOG  DIALOGEX 0, 0, 240, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "[Create New Package]"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Name:", IDC_TEXTBOX_LABEL_NAME, 10, 12, 40, 10
    EDITTEXT    IDC_TEXTBOX_NAME, 60, 10, 120, 12, ES_AUTOHSCROLL

    DEFPUSHBUTTON "Create",
                   IDOK,
                   70, 30, 50, 14

    PUSHBUTTON    "Cancel",
                   IDCANCEL,
                   130, 30, 50, 14
END