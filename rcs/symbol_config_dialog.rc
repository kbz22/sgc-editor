#include "symbol_config_dialog.h"
#include <windows.h>

IDD_SYMBOL_CONFIG DIALOGEX 0, 0, SYMBOL_DIALOG_WIDTH, SYMBOL_DIALOG_HEIGHT
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"

BEGIN
    GROUPBOX    "Group settings", IDC_SYMBOL_GROUP_LABEL,
                SYMBOL_DIALOG_BORDER_X_OFFSET,
                SYMBOL_DIALOG_BORDER_Y_OFFSET,
                SYMBOL_DIALOG_GROUP_WIDTH,
                32

    COMBOBOX    IDC_SYMBOL_GROUP_COMBO,
                SYMBOL_DIALOG_ITEM_X,
                20,
                SYMBOL_DIALOG_GROUP_INNER_WIDTH,
                80,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX    "Group settings", IDC_SYMBOL_GROUP_CONFIG,
                SYMBOL_DIALOG_BORDER_X_OFFSET,
                46,
                SYMBOL_DIALOG_GROUP_WIDTH,
                80

    LTEXT       "Symbol width:", IDC_SYMBOL_SIZE_X_LABEL,
                SYMBOL_DIALOG_ITEM_X,
                61,
                80,
                10

    EDITTEXT    IDC_SYMBOL_SIZE_X,
                SYMBOL_DIALOG_EDIT_X_OFFSET,
                59,
                30,
                13,
                ES_AUTOHSCROLL | ES_NUMBER

    LTEXT       "Symbol height:", IDC_SYMBOL_SIZE_Y_LABEL,
                SYMBOL_DIALOG_ITEM_X,
                77,
                80,
                10

    EDITTEXT    IDC_SYMBOL_SIZE_Y,
                SYMBOL_DIALOG_EDIT_X_OFFSET
                75,
                30,
                13,
                ES_AUTOHSCROLL | ES_NUMBER
    
    CONTROL     "", IDC_SYMBOL_TILESET_VIEW, "SymbolTilesetControl",
                WS_CHILD | WS_VISIBLE | WS_BORDER | WS_HSCROLL | WS_VSCROLL,
                SYMBOL_DIALOG_SIDEBAR_WIDTH,
                SYMBOL_DIALOG_BORDER_Y_OFFSET,
                SYMBOL_DIALOG_TILESET_WIDTH - SYMBOL_DIALOG_BORDER_X_OFFSET,
                SYMBOL_DIALOG_TILESET_HEIGHT

    PUSHBUTTON      "Restore defaults", IDC_SYMBOL_RESTORE_DEFAULTS,
                    SYMBOL_DIALOG_ITEM_X,
                    46 + 72 - SYMBOL_DIALOG_BUTTON_HEIGHT,
                    58,
                    SYMBOL_DIALOG_BUTTON_HEIGHT
    
    PUSHBUTTON      "Add",
                    IDC_SYMBOL_ADD_GROUP,
                    SYMBOL_DIALOG_ADD_X_OFFSET,
                    46 + 72 - SYMBOL_DIALOG_BUTTON_HEIGHT,
                    44,
                    SYMBOL_DIALOG_BUTTON_HEIGHT

    DEFPUSHBUTTON   "Save", IDOK,
                    SYMBOL_DIALOG_BORDER_X_OFFSET,
                    SYMBOL_DIALOG_HEIGHT - SYMBOL_DIALOG_BUTTON_HEIGHT - SYMBOL_DIALOG_BORDER_Y_OFFSET,
                    60,
                    SYMBOL_DIALOG_BUTTON_HEIGHT

    PUSHBUTTON      "Cancel", IDCANCEL,
                    SYMBOL_DIALOG_SIDEBAR_WIDTH - 60 - SYMBOL_DIALOG_BORDER_X_OFFSET,
                    SYMBOL_DIALOG_HEIGHT - SYMBOL_DIALOG_BUTTON_HEIGHT - SYMBOL_DIALOG_BORDER_Y_OFFSET,
                    60,
                    SYMBOL_DIALOG_BUTTON_HEIGHT
END
