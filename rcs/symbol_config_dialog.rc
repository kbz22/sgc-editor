#include "symbol_config_dialog.h"
#include <windows.h>

IDD_SYMBOL_CONFIG DIALOGEX 0, 0, SYMBOL_DIALOG_WIDTH, SYMBOL_DIALOG_HEIGHT
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"

BEGIN
    LTEXT       "Symbol group", -1,
                SYMBOL_DIALOG_OFFSET_X,
                5,
                SYMBOL_SIDEBAR_WIDTH,
                12
    COMBOBOX    IDC_SYMBOL_GROUP_COMBO,
                SYMBOL_DIALOG_OFFSET_X,
                18,
                SYMBOL_SIDE_LABEL_WIDTH,
                80,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Add",
                IDC_SYMBOL_ADD_GROUP,
                SYMBOL_DIALOG_OFFSET_X_SIDE,
                17,
                SYMBOL_ADD_WIDTH,
                14

    GROUPBOX    "Group settings", IDC_SYMBOL_GROUP_CONFIG,
                SYMBOL_DIALOG_OFFSET_X,
                36,
                SYMBOL_SIDEBAR_WIDTH - 20,
                55

    LTEXT       "Symbol width:", IDC_SYMBOL_SIZE_X_LABEL,
                SYMBOL_DIALOG_OFFSET_X + SYMBOL_DIALOG_GROUP_OFFSET_X,
                51,
                SYMBOL_SIDE_LABEL_WIDTH,
                10
    EDITTEXT    IDC_SYMBOL_SIZE_X,
                SYMBOL_DIALOG_OFFSET_X_SIDE - SYMBOL_DIALOG_OFFSET_X,
                49,
                SYMBOL_ADD_WIDTH,
                12,
                ES_AUTOHSCROLL | ES_NUMBER

    LTEXT       "Symbol height:", IDC_SYMBOL_SIZE_Y_LABEL,
                SYMBOL_DIALOG_OFFSET_X + SYMBOL_DIALOG_GROUP_OFFSET_X,
                71,
                SYMBOL_SIDE_LABEL_WIDTH,
                10
    EDITTEXT    IDC_SYMBOL_SIZE_Y,
                SYMBOL_DIALOG_OFFSET_X_SIDE- SYMBOL_DIALOG_OFFSET_X,
                69,
                SYMBOL_ADD_WIDTH  ,
                12,
                ES_AUTOHSCROLL | ES_NUMBER
    
    CONTROL     "", IDC_SYMBOL_TILESET_VIEW, "SymbolTilesetControl",
                WS_CHILD | WS_VISIBLE | WS_BORDER,
                SYMBOL_SIDEBAR_WIDTH,
                5,
                TILESET_VIEW_WIDTH,
                SYMBOL_DIALOG_HEIGHT - SYMBOL_DIALOG_OFFSET_X

    DEFPUSHBUTTON "Save",
                   IDOK,
                   SYMBOL_DIALOG_OFFSET_X, SYMBOL_DIALOG_HEIGHT - SYMBOL_OK_BUTTON_HEIGHT - 5, 50, SYMBOL_OK_BUTTON_HEIGHT

    PUSHBUTTON    "Cancel",
                   IDCANCEL,
                   SYMBOL_DIALOG_OFFSET_X + 50 + SYMBOL_DIALOG_OFFSET_X, SYMBOL_DIALOG_HEIGHT - SYMBOL_OK_BUTTON_HEIGHT - 5, 50, SYMBOL_OK_BUTTON_HEIGHT
END
